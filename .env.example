# Copy to .env and fill in. The Gmail account that sends needs 2-Step
# Verification enabled, then an App Password from
# https://myaccount.google.com/apppasswords (16 characters).

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Where the chosen time is delivered. Defaults to GMAIL_USER if unset.
TO_EMAIL=you@gmail.com

PORT=3000
